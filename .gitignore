# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.venv/
venv/
.env
.env.*

# IDE/editor
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Test/cache
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build output
build/
dist/
*.egg-info/

# Local project data files: keep the structure and documentation tracked,
# but avoid committing raw, interim, processed, or archive datasets.
data/raw/*
data/interim/*
data/processed/*
data/raw/**/*.csv
data/raw/**/*.xlsx
data/raw/**/*.xls
data/raw/**/*.parquet
data/raw/**/*.pkl
data/raw/**/*.zip
data/raw/**/*.gz
data/raw/**/*.json
data/raw/**/*.db
data/raw/**/*.sqlite
data/raw/**/*.sqlite3
data/interim/**/*.csv
data/interim/**/*.xlsx
data/interim/**/*.xls
data/interim/**/*.parquet
data/interim/**/*.pkl
data/interim/**/*.zip
data/interim/**/*.gz
data/interim/**/*.json
data/interim/**/*.db
data/interim/**/*.sqlite
data/interim/**/*.sqlite3
data/processed/**/*.csv
data/processed/**/*.xlsx
data/processed/**/*.xls
data/processed/**/*.parquet
data/processed/**/*.pkl
data/processed/**/*.zip
data/processed/**/*.gz
data/processed/**/*.json
data/processed/**/*.db
data/processed/**/*.sqlite
data/processed/**/*.sqlite3
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/metadata/.gitkeep
!data/README.md
!data/metadata/
!data/metadata/**

# Optional local dataset archives or credentials scoped to project data only
# (not global source-code fixtures)
data/raw/**/*.zip
data/raw/**/*.gz
data/interim/**/*.zip
data/interim/**/*.gz
data/processed/**/*.zip
data/processed/**/*.gz
